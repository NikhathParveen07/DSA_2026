#include <bits/stdc++.h>
using namespace std;

void move_zeroes(vector<int> &arr){
    int left = 0;
    for(int right = 0; right < arr.size(); right++){
        if(arr[right] != 0){
            swap(arr[left], arr[right]);
            left++;
        }
    }
}


int main() {
    
    vector<int> arr;
    string input;
    getline(cin, input);
    stringstream ss(input);
    char ch;
    ss >> ch;
    int num;
    while(ss >> num){
        arr.push_back(num);
        ss >> ch;
    }
    move_zeroes(arr);
    for(int num:arr){
       cout << num << " ";
    }
   return 0;
}
