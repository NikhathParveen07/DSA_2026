#include <bits/stdc++.h>
using namespace std;

vector<int> twosum(vector<int> arr, int target){
    int left = 0, right = arr.size()-1;
    sort(arr.begin(), arr.end());
    while(left < right){
        int s = arr[left] + arr[right];
        if(s < target) left++;
        else if(s > target) right--;
        else{
            return {left, right};
        }
    }
    return {};
}

int main() {
    vector<int> arr;
	string input;
	getline(cin, input);
	stringstream ss(input);
	char ch;
	ss >> ch;
	int num;
	while(ss >> num){
	    arr.push_back(num);
	    ss >> ch;
	}
	int target;
	cin >> target;
	
	vector <int> ans = twosum(arr, target);
	
	for(auto num: ans){
	    cout << num << " ";
	}

}
